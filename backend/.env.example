DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# When True, payments succeed instantly (no real M-Pesa call). Use for development.
MPESA_SIMULATE=True

# M-Pesa Daraja (only needed when MPESA_SIMULATE=False)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://your-public-domain.example/api/payments/callback/
